{
  "name": "intelligent-archive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": "^24.22.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node node_modules/payload/bin.js migrate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "payload": "node --env-file-if-exists=.env.local node_modules/payload/bin.js",
    "generate:types": "pnpm payload generate:types",
    "generate:importmap": "pnpm payload generate:importmap",
    "db:migrate": "pnpm payload migrate",
    "db:seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "admin:bootstrap": "node --env-file-if-exists=.env.local --import tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "payload": "3.94.1",
    "@payloadcms/next": "3.94.1",
    "@payloadcms/db-postgres": "3.94.1",
    "@payloadcms/richtext-lexical": "3.94.1",
    "@payloadcms/storage-vercel-blob": "3.94.1",
    "@payloadcms/plugin-seo": "3.94.1",
    "@payloadcms/plugin-redirects": "3.94.1",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "graphql": "16.15.0",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.5",
    "@tailwindcss/postcss": "4.3.5",
    "@radix-ui/react-slot": "1.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.1",
    "motion": "14.14.0",
    "lucide-react": "1.79.0",
    "zod": "4.6.7",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0"
  },
  "devDependencies": {
    "@types/node": "24.19.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "prettier": "3.10.1",
    "vitest": "5.1.1",
    "@playwright/test": "1.65.1",
    "@axe-core/playwright": "4.14.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "eslint-config-next": "16.4.6"
  }
}
